{
  "name": "@zenith/contracts",
  "version": "0.1.0",
  "description": "Typed TypeScript clients, network config and event decoders for the Zenith Soroban contracts, generated from their on-chain spec.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zenith-options/contracts",
    "directory": "bindings"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "deployments.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "16.3.1",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
